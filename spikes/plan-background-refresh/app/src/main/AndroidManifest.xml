<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Thymian soak spike"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".SoakActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A placed widget is part of the test: the real app always has one, which may change its standby bucket. -->
        <receiver
            android:name=".SoakWidgetProvider"
            android:exported="true"
            android:label="Thymian soak spike">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soak_widget_info" />
        </receiver>
    </application>
</manifest>
